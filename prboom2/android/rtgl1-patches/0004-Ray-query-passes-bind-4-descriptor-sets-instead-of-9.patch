+// ShaderCommonGLSLFunc.h remaps light bindings to BINDING_RQ_LIGHT_SOURCES_FIRST + i
+constexpr bool AreLightBindingsSequential()
+{
+    for (uint32_t i = 0; i < LIGHT_SOURCE_BINDING_COUNT; i++)
