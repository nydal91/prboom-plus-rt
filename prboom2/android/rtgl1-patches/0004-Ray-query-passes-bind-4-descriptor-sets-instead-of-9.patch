+void RayTracingPipeline::CreateCombinedDescriptors()
+{
+    // Types and counts must match the source sets' layouts:
+    // ASManager (TLAS), GlobalUniform, BlueNoise, CubemapManager, RenderCubemap, LightManager
+    std::vector<VkDescriptorSetLayoutBinding> bindings;
+
+    auto add = [&bindings] (uint32_t binding, VkDescriptorType type, uint32_t count)
+    {
+        VkDescriptorSetLayoutBinding b = {};
+        b.binding = binding;
+        b.descriptorType = type;
+        b.descriptorCount = count;
+        b.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+        bindings.push_back(b);
+    };
+
+    add(BINDING_RQ_ACCELERATION_STRUCTURE_MAIN, VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR, 1);
+    add(BINDING_RQ_GLOBAL_UNIFORM,              VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER,             1);
+    add(BINDING_RQ_BLUE_NOISE,                  VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,              1);
+    add(BINDING_RQ_CUBEMAPS,                    VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,     MAX_CUBEMAP_COUNT);
+    add(BINDING_RQ_RENDER_CUBEMAP,              VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,     1);
+    for (uint32_t i = 0; i < LIGHT_SOURCE_BINDING_COUNT; i++)
+    {
+        add(BINDING_RQ_LIGHT_SOURCES_FIRST + i, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1);
+    }
+
+    VkDescriptorSetLayoutCreateInfo layoutInfo = {};
+    layoutInfo.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+    layoutInfo.bindingCount = static_cast<uint32_t>(bindings.size());
+    layoutInfo.pBindings = bindings.data();
+
+    VkResult r = vkCreateDescriptorSetLayout(device, &layoutInfo, nullptr, &combinedSetLayout);
+    VK_CHECKERROR(r);
+
+    SET_DEBUG_NAME(device, combinedSetLayout, VK_OBJECT_TYPE_DESCRIPTOR_SET_LAYOUT, "Ray query combined Desc set layout");
+
+    VkDescriptorPoolSize poolSizes[] =
+    {
+        { VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR,    1 * MAX_FRAMES_IN_FLIGHT },
+        { VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER,                1 * MAX_FRAMES_IN_FLIGHT },
+        { VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,                 1 * MAX_FRAMES_IN_FLIGHT },
+        { VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,        (MAX_CUBEMAP_COUNT + 1) * MAX_FRAMES_IN_FLIGHT },
+        { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,                LIGHT_SOURCE_BINDING_COUNT * MAX_FRAMES_IN_FLIGHT },
+    };
+
+    VkDescriptorPoolCreateInfo poolInfo = {};
+    poolInfo.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+    poolInfo.maxSets = MAX_FRAMES_IN_FLIGHT;
+    poolInfo.poolSizeCount = static_cast<uint32_t>(std::size(poolSizes));
+    poolInfo.pPoolSizes = poolSizes;
+
+    r = vkCreateDescriptorPool(device, &poolInfo, nullptr, &combinedPool);
+    VK_CHECKERROR(r);
+
+    SET_DEBUG_NAME(device, combinedPool, VK_OBJECT_TYPE_DESCRIPTOR_POOL, "Ray query combined Desc pool");
+
+    for (uint32_t i = 0; i < MAX_FRAMES_IN_FLIGHT; i++)
+    {
+        VkDescriptorSetAllocateInfo allocInfo = {};
+        allocInfo.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+        allocInfo.descriptorPool = combinedPool;
+        allocInfo.descriptorSetCount = 1;
+        allocInfo.pSetLayouts = &combinedSetLayout;
+
+        r = vkAllocateDescriptorSets(device, &allocInfo, &combinedSets[i]);
+        VK_CHECKERROR(r);
+
+        SET_DEBUG_NAME(device, combinedSets[i], VK_OBJECT_TYPE_DESCRIPTOR_SET, "Ray query combined Desc set");
+    }
+}
+
+VkDescriptorSet RayTracingPipeline::UpdateCombinedDescSet(uint32_t frameIndex, const CombinedSetSources &src)
+{
+    assert(frameIndex < MAX_FRAMES_IN_FLIGHT);
+    VkDescriptorSet dst = combinedSets[frameIndex];
+
+    std::vector<VkCopyDescriptorSet> copies;
+    copies.reserve(5 + LIGHT_SOURCE_BINDING_COUNT);
+
+    auto copy = [&copies, dst] (VkDescriptorSet srcSet, uint32_t srcBinding, uint32_t dstBinding, uint32_t count)
+    {
+        VkCopyDescriptorSet c = {};
+        c.sType = VK_STRUCTURE_TYPE_COPY_DESCRIPTOR_SET;
+        c.srcSet = srcSet;
+        c.srcBinding = srcBinding;
+        c.srcArrayElement = 0;
+        c.dstSet = dst;
+        c.dstBinding = dstBinding;
+        c.dstArrayElement = 0;
+        c.descriptorCount = count;
+        copies.push_back(c);
+    };
+
+    // original bindings: see the source managers; remapped ones: BINDING_RQ_*
+    copy(src.tlas,          BINDING_ACCELERATION_STRUCTURE_MAIN,    BINDING_RQ_ACCELERATION_STRUCTURE_MAIN, 1);
+    copy(src.uniform,       BINDING_GLOBAL_UNIFORM,                 BINDING_RQ_GLOBAL_UNIFORM,              1);
+    copy(src.blueNoise,     BINDING_BLUE_NOISE,                     BINDING_RQ_BLUE_NOISE,                  1);
+    copy(src.cubemaps,      BINDING_CUBEMAPS,                       BINDING_RQ_CUBEMAPS,                    MAX_CUBEMAP_COUNT);
+    copy(src.renderCubemap, BINDING_RENDER_CUBEMAP,                 BINDING_RQ_RENDER_CUBEMAP,              1);
+    for (uint32_t i = 0; i < LIGHT_SOURCE_BINDING_COUNT; i++)
+    {
+        copy(src.lightSources, LIGHT_SOURCE_BINDINGS[i], BINDING_RQ_LIGHT_SOURCES_FIRST + i, 1);
+    }
+
+    vkUpdateDescriptorSets(device, 0, nullptr, static_cast<uint32_t>(copies.size()), copies.data());
+
+    return dst;
 }
 
