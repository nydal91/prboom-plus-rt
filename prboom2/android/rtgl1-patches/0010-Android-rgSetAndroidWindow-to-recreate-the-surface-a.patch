From dc65be7a6f56f0c522d8b5f3368e2e5c991495ce Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 22 Oct 2026 20:29:40 +0200
Subject: [PATCH 10/11] Android: rgSetAndroidWindow to recreate the surface
 after the app was in the background

- Swapchain::ChangeSurface rebuilds the swapchain on a new VkSurfaceKHR
- present no longer recreates the swapchain itself on out-of-date / lost:
  it's deferred to the next acquire, after a new surface may have been set

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01K7ddVeaJCm7c4L64HWexay
---
 Include/RTGL1/RTGL1.h   |  9 +++++++++
 Source/RTGL1.cpp        | 11 +++++++++++
 Source/Swapchain.cpp    | 27 +++++++++++++++++++++++++--
 Source/Swapchain.h      |  7 +++++++
 Source/VulkanDevice.cpp | 32 ++++++++++++++++++++++++++++++++
 Source/VulkanDevice.h   |  5 +++++
 6 files changed, 89 insertions(+), 2 deletions(-)

diff --git a/Include/RTGL1/RTGL1.h b/Include/RTGL1/RTGL1.h
index 2e80998..0aaf6b7 100644
--- a/Include/RTGL1/RTGL1.h
+++ b/Include/RTGL1/RTGL1.h
@@ -455,6 +455,15 @@ RGAPI RgResult RGCONV rgUpdateGeometryTexCoords(
 
 // Clear current scene from all static geometries and make it available for recording new geometries.
 // New scene can be visible only after the submission using rgSubmitStaticGeometries.
+#ifdef RG_USE_SURFACE_ANDROID
+// Android destroys the window's surface when the app goes to the background
+// and creates a new one when it returns: pass the new window before the next
+// frame. Must be called outside of rgStartFrame / rgDrawFrame.
+RGAPI RgResult RGCONV rgSetAndroidWindow(
+    RgInstance                          rgInstance,
+    struct ANativeWindow                *window);
+#endif // RG_USE_SURFACE_ANDROID
+
 RGAPI RgResult RGCONV rgStartNewScene(
     RgInstance                          rgInstance);
 
diff --git a/Source/RTGL1.cpp b/Source/RTGL1.cpp
index 1053d81..55c36f2 100644
--- a/Source/RTGL1.cpp
+++ b/Source/RTGL1.cpp
@@ -180,6 +180,17 @@ RgResult rgSubmitStaticGeometries(RgInstance rgInstance)
     CATCH_OR_RETURN;
 }
 
+#ifdef RG_USE_SURFACE_ANDROID
+RgResult rgSetAndroidWindow(RgInstance rgInstance, struct ANativeWindow *window)
+{
+    try
+    {
+        GetDevice(rgInstance)->SetAndroidWindow(window);
+    }
+    CATCH_OR_RETURN;
+}
+#endif // RG_USE_SURFACE_ANDROID
+
 RgResult rgStartNewScene(RgInstance rgInstance)
 {
     try
diff --git a/Source/Swapchain.cpp b/Source/Swapchain.cpp
index 738d67b..91e9adf 100644
--- a/Source/Swapchain.cpp
+++ b/Source/Swapchain.cpp
@@ -133,8 +133,29 @@ bool Swapchain::RequestVsync(bool enable)
     return requestedVsync != isVsync;
 }
 
+void Swapchain::ChangeSurface(VkSurfaceKHR newSurface)
+{
+    cmdManager->WaitDeviceIdle();
+
+    // destroys the swapchain and notifies subscribers
+    Destroy();
+
+    surface = newSurface;
+    isOutdated = false;
+
+    // force TryRecreate to create a swapchain
+    surfaceExtent = { 0, 0 };
+    TryRecreate(requestedExtent.width, requestedExtent.height, requestedVsync);
+}
+
 void Swapchain::AcquireImage(VkSemaphore imageAvailableSemaphore)
 {
+    if (isOutdated)
+    {
+        isOutdated = false;
+        surfaceExtent = { 0, 0 }; // force
+    }
+
     // if requested params are different
     if (requestedExtent.width != surfaceExtent.width || 
         requestedExtent.height != surfaceExtent.height || 
@@ -230,9 +251,11 @@ void Swapchain::Present(const std::shared_ptr<Queues> &queues, VkSemaphore rende
 
     VkResult r = vkQueuePresentKHR(queues->GetGraphics(), &presentInfo);
 
-    if (r == VK_ERROR_OUT_OF_DATE_KHR || r == VK_SUBOPTIMAL_KHR)
+    // Recreate at the next AcquireImage, not here: if the surface was lost
+    // (Android app in background), a new one is set before the next frame.
+    if (r == VK_ERROR_OUT_OF_DATE_KHR || r == VK_SUBOPTIMAL_KHR || r == VK_ERROR_SURFACE_LOST_KHR)
     {
-        TryRecreate(requestedExtent.width, requestedExtent.height, requestedVsync);
+        isOutdated = true;
     }
 }
 
diff --git a/Source/Swapchain.h b/Source/Swapchain.h
index ea7be23..0fb805c 100644
--- a/Source/Swapchain.h
+++ b/Source/Swapchain.h
@@ -52,6 +52,11 @@ public:
     bool RequestNewSize(uint32_t newWidth, uint32_t newHeight);
     bool RequestVsync(bool enable);
 
+    // The window's surface was replaced (Android recreates it after the app was
+    // in the background): destroy the swapchain and create it on the new surface.
+    // The caller destroys the old surface afterwards.
+    void ChangeSurface(VkSurfaceKHR newSurface);
+
     void AcquireImage(VkSemaphore imageAvailableSemaphore);
     void BlitForPresent(VkCommandBuffer cmd, VkImage srcImage, uint32_t srcImageWidth, uint32_t srcImageHeight, VkFilter filter, VkImageLayout srcImageLayout = VK_IMAGE_LAYOUT_GENERAL);
     void Present(const std::shared_ptr<Queues> &queues, VkSemaphore renderFinishedSemaphore);
@@ -99,6 +104,8 @@ private:
     // current surface's size
     VkExtent2D surfaceExtent;
     bool isVsync;
+    // the last present reported the swapchain as out of date / lost
+    bool isOutdated = false;
 
     VkSwapchainKHR swapchain;
     std::vector<VkImage> swapchainImages;
diff --git a/Source/VulkanDevice.cpp b/Source/VulkanDevice.cpp
index 87936ad..e1ecabf 100644
--- a/Source/VulkanDevice.cpp
+++ b/Source/VulkanDevice.cpp
@@ -1848,6 +1848,38 @@ void VulkanDevice::CreateSyncPrimitives()
     }
 }
 
+#ifdef RG_USE_SURFACE_ANDROID
+void VulkanDevice::SetAndroidWindow(struct ANativeWindow *window)
+{
+    if (window == nullptr)
+    {
+        throw RgException(RG_WRONG_ARGUMENT, "Android window is null");
+    }
+
+    VkAndroidSurfaceCreateInfoKHR androidInfo = {};
+    androidInfo.sType = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR;
+    androidInfo.window = window;
+
+    VkSurfaceKHR newSurface = VK_NULL_HANDLE;
+    VkResult r = vkCreateAndroidSurfaceKHR(instance, &androidInfo, nullptr, &newSurface);
+    VK_CHECKERROR(r);
+
+    VkBool32 isSupported = VK_FALSE;
+    r = vkGetPhysicalDeviceSurfaceSupportKHR(physDevice->Get(), queues->GetIndexGraphics(), newSurface, &isSupported);
+    VK_CHECKERROR(r);
+    if (!isSupported)
+    {
+        vkDestroySurfaceKHR(instance, newSurface, nullptr);
+        throw RgException(RG_GRAPHICS_API_ERROR, "New Android window can't be presented to");
+    }
+
+    swapchain->ChangeSurface(newSurface);
+
+    vkDestroySurfaceKHR(instance, surface, nullptr);
+    surface = newSurface;
+}
+#endif // RG_USE_SURFACE_ANDROID
+
 VkSurfaceKHR VulkanDevice::GetSurfaceFromUser(VkInstance instance, const RgInstanceCreateInfo &info)
 {
     VkSurfaceKHR surface;
diff --git a/Source/VulkanDevice.h b/Source/VulkanDevice.h
index 74670be..26011ba 100644
--- a/Source/VulkanDevice.h
+++ b/Source/VulkanDevice.h
@@ -110,6 +110,11 @@ private:
     void CreateDevice();
     void CreateSyncPrimitives();
     static VkSurfaceKHR GetSurfaceFromUser(VkInstance instance, const RgInstanceCreateInfo &info);
+public:
+#ifdef RG_USE_SURFACE_ANDROID
+    void SetAndroidWindow(struct ANativeWindow *window);
+#endif
+private:
     void ValidateCreateInfo(const RgInstanceCreateInfo *pInfo);
 
     void DestroyInstance();
